# 디몰비전 API — 환경변수 예시. 실제 값은 .env 에만 두고 커밋하지 않는다.
PORT=8080
# CORS 허용 오리진(쉼표 구분). 데모는 * (전체 허용).
CORS_ORIGINS=*

# 비전 공급자(우선순위 자체GPU VLM > Groq > Gemini > Claude). 하나만 있어도 됨. 없으면 목(mock) 분석.

# 자체 호스팅 VLM — Cloud Run GPU 위의 vLLM(상용화 경로). 설정하면 최우선으로 쓴다.
# 배포: ./infra/gcp/deploy-vlm.sh — 자세한 내용은 infra/gcp/README.md
VLM_BASE_URL=
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# VLM_API_KEY=            # Cloud Run 을 비공개로 둘 때만
# Groq — 무료 티어, 카드 불필요: https://console.groq.com
GROQ_API_KEY=
# Google Gemini — 무료 티어: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic Claude(유료)
ANTHROPIC_API_KEY=

# (선택) 모델/타임아웃 오버라이드
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
# VISION_TIMEOUT_MS=30000

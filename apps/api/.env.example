# 디몰비전 API — 환경변수 예시. 실제 값은 .env 에만 두고 커밋하지 않는다.
PORT=8080
# CORS 허용 오리진(쉼표 구분). 데모는 * (전체 허용).
CORS_ORIGINS=*

# 비전 공급자(우선순위 자체GPU VLM > Groq > Gemini > Claude). 하나만 있어도 됨. 없으면 목(mock) 분석.

# 자체 호스팅 VLM — Cloud Run GPU 위의 vLLM(상용화 경로). 설정하면 최우선으로 쓴다.
# 배포: ./infra/gcp/deploy-vlm.sh — 자세한 내용은 infra/gcp/README.md
VLM_BASE_URL=
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# VLM_API_KEY=            # Cloud Run 을 비공개로 둘 때만
# Groq — 무료 티어, 카드 불필요: https://console.groq.com
GROQ_API_KEY=
# Google Gemini — 무료 티어: https://aistudio.google.com/apikey
# 한도는 프로젝트별로 걸리므로, 서로 다른 프로젝트의 키를 쉼표로 여러 개 넣으면 처리량이 늘어난다.
GEMINI_API_KEYS=
# (하위호환) 단일 키만 쓸 때
GEMINI_API_KEY=
# Anthropic Claude(유료)
ANTHROPIC_API_KEY=

# (선택) 모델/타임아웃 오버라이드
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6
# VISION_TIMEOUT_MS=30000

# ── 공공데이터(선택) ────────────────────────────────────────────
# 건축물대장 조회 — 주구조·연면적·층수·사용승인연도를 받아 분석 힌트와 물량 추정에 넣는다.
# 특히 사용승인연도는 석면 판단에 결정적이다(2009년 석면 사용 전면 금지).
# 키가 없으면 공공데이터 보강 없이 사진만으로 분석한다(서비스는 그대로 동작).
# 발급: https://www.data.go.kr → '건축물대장정보 서비스' 활용신청 → 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=
# PUBLIC_DATA_TIMEOUT_MS=5000

# 건물 외곽선(GIS건물통합정보 WFS) — 공공데이터로 평면 형상을 얻는 유일한 경로다.
# 건축물대장의 평면도(건축물현황도)는 「건축물대장의 기재 및 관리 등에 관한 규칙」상
# 소유자 동의가 있어야 열람돼 임의 건물에는 쓸 수 없다. 반면 건물 외곽선은 공개돼 있어
# 건물 전체 철거라면 영상을 찍지 않고도 실제 형상과 건축면적을 근거 있게 얻는다.
# 위 인증키를 함께 쓰며, 둘 다 채워야 기능이 켜진다(없으면 조용히 꺼진다).
# 발급: https://www.data.go.kr → 'GIS건물통합정보(WMS/WFS)' 활용신청
# 주소·레이어명은 서비스 이관으로 바뀌어 왔으므로 승인 화면의 값을 그대로 넣는다.
BUILDING_OUTLINE_WFS_URL=
BUILDING_OUTLINE_TYPENAME=

# ── 지도에서 현장 찍기(선택) ────────────────────────────────────
# 카카오 로컬 API — 지도에서 찍은 좌표를 지번(시군구·법정동 코드, 본번·부번)으로 옮긴다.
# 건축물대장이 주소 문자열을 받지 않아 이 변환이 반드시 필요하다. 키가 없으면 지도 화면이
# "주소 변환이 설정되지 않았습니다" 를 띄우고, 사용자가 연면적·건축년도를 직접 입력하게 된다.
# 발급: https://developers.kakao.com → 앱 생성 → REST API 키
KAKAO_REST_API_KEY=
# KAKAO_TIMEOUT_MS=5000

# ── 3D 복원(선택) ──────────────────────────────────────────────
# COLMAP 복원 서버(Cloud Run GPU). 없으면 /recon.html 의 복원이 503 을 낸다.
# 배포: PROJECT_ID=<프로젝트ID> ./infra/gcp/deploy-vlm.sh 참고(infra/gcp/README.md)
# COLMAP 은 수 분이 걸리므로 비전 분석과 타임아웃을 공유하지 않는다.
RECON_BASE_URL=
# RECON_TIMEOUT_MS=600000
# RECON_API_KEY=            # 복원 서버를 비공개로 둘 때만

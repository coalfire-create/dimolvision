# 디몰비전 앱 — 백엔드 API 주소. 빌드/실행 시 이 값으로 오버라이드한다.
# 로컬 개발: 같은 머신의 API
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
# 배포 예시: https://dimolvision-api.up.railway.app/api

# 웹 배포 오리진 — 네이티브(iOS/Android) 빌드에서 무로그인 체험 샘플 사진을 받아올 곳.
# 웹에서는 같은 오리진의 /samples 를 쓰므로 필요 없다(네이티브 빌드에만 지정).
EXPO_PUBLIC_WEB_BASE_URL=https://dimolvision.vercel.app
